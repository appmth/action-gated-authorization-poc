# ===========================================
# Envoy Gateway - Local Development
# ===========================================
# Uses envsubst for environment variable substitution
# at container startup (Docker best practice).

FROM envoyproxy/envoy:v1.28-latest

# Install gettext for envsubst
RUN apt-get update && apt-get install -y gettext-base && rm -rf /var/lib/apt/lists/*

# Copy template and entrypoint
COPY envoy-local.yaml /etc/envoy/envoy.yaml.template
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
