# ===========================================
# AGA PoC - Production Environment Variables
# ===========================================
# Cloud Run デプロイ用の環境変数
# 機密情報なし（機密情報は Secret Manager で管理）

# -------------------------------------------
# Domain
# -------------------------------------------
DOMAIN=action-gated.tech

# -------------------------------------------
# Service URLs
# -------------------------------------------
SERVICE_A_URL=https://service-a.action-gated.tech
SERVICE_B_URL=https://service-b.action-gated.tech
SERVICE_C_URL=https://service-c.action-gated.tech
ENVOY_GATEWAY_URL=https://envoy-gateway.action-gated.tech

# -------------------------------------------
# service-b (PDP/OPA)
# -------------------------------------------
ENVIRONMENT=production
OPA_LOG_LEVEL=info
OPA_LOG_FORMAT=json

# -------------------------------------------
# service-a (Judgment)
# -------------------------------------------
PDP_URL=https://service-b.action-gated.tech
TOOL_URL=https://service-c.action-gated.tech
ENVOY_URL=https://envoy-gateway.action-gated.tech

# -------------------------------------------
# Vertex AI
# -------------------------------------------
VERTEX_PROJECT=aga-poc
VERTEX_LOCATION=asia-northeast1
VERTEX_MODEL=gemini-2.0-flash

# -------------------------------------------
# envoy-gateway
# -------------------------------------------
SERVICE_A_HOST=service-a.action-gated.tech
SERVICE_A_PORT=443
SERVICE_C_HOST=service-c.action-gated.tech
SERVICE_C_PORT=443
JWKS_URI=https://service-a.action-gated.tech/.well-known/jwks.json
UPSTREAM_TLS_SERVICE_A="transport_socket: { name: 'envoy.transport_sockets.tls', typed_config: { '@type': 'type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext', sni: 'service-a.action-gated.tech', common_tls_context: { alpn_protocols: ['h2'] } } }"
UPSTREAM_TLS_SERVICE_C="transport_socket: { name: 'envoy.transport_sockets.tls', typed_config: { '@type': 'type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext', sni: 'service-c.action-gated.tech', common_tls_context: { alpn_protocols: ['h2'] } } }"

# -------------------------------------------
# judgment-ui / gov-ui
# -------------------------------------------
NEXT_PUBLIC_API_URL=https://service-a.action-gated.tech
