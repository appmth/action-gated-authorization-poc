# ===========================================
# AGA PoC - Local Environment Variables
# ===========================================
# ローカル開発用の環境変数（docker-compose用）
# .env.local にコピーして使用してください

# -------------------------------------------
# Service URLs (Host から見たURL)
# -------------------------------------------
SERVICE_A_URL=http://localhost:8080
SERVICE_B_URL=http://localhost:8181
SERVICE_C_URL=http://localhost:8082
ENVOY_GATEWAY_URL=http://localhost:10000

# -------------------------------------------
# service-a (Judgment) - コンテナ間通信
# -------------------------------------------
PDP_URL=http://service-b:8080
TOOL_URL=http://service-c:8080
ENVOY_URL=http://envoy-gateway:8080

# -------------------------------------------
# Vertex AI (ローカルでは Optional)
# -------------------------------------------
VERTEX_PROJECT=aga-poc
VERTEX_LOCATION=asia-northeast1
VERTEX_MODEL=gemini-2.0-flash

# -------------------------------------------
# envoy-gateway
# -------------------------------------------
SERVICE_A_HOST=service-a
SERVICE_A_PORT=8080
SERVICE_C_HOST=service-c
SERVICE_C_PORT=8080
JWKS_URI=http://service-a:8080/.well-known/jwks.json

# -------------------------------------------
# agent-simulator
# -------------------------------------------
SERVICE_A_BASE_URL=http://service-a:8080

# -------------------------------------------
# judgment-ui / gov-ui
# -------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
